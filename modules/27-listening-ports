#!/bin/bash

## Version 0.4.0
# Description: Listening TCP and UDP sockets

set -euo pipefail

# Shared configuration and display functions.
# shellcheck disable=SC1090
source "${MOTD_FRAMEWORK:-$(dirname -- "${BASH_SOURCE[0]}")/../lib/framework.sh}"
motd_init "${0##*/}" || {
    status=$?
    (( status == 1 )) && exit 0
    exit "$status"
}

motd_need ss || exit 0
records=$(motd_run ss -H -lntu) || exit 1
text=""
count=0
while read -r protocol state receive send local_address peer rest; do
    [[ -n $protocol ]] || continue
    append_line text "$protocol $local_address"
    count=$((count + 1))
    (( count < MOTD_MAX_ITEMS )) || { append_line text "Display limit: $MOTD_MAX_ITEMS"; break; }
done <<< "$records"
print_columns "Listening ports" "${text:-None}"
